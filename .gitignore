# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# ── Frontend ──────────────────────────────────────────
# dependencies (root orphan + proper location)
node_modules/
frontend/node_modules/
frontend/.pnp
frontend/pnp.js

# testing
frontend/coverage/

# production build output
frontend/build/

# misc
.DS_Store
frontend/.env.local
frontend/.env.development.local
frontend/.env.test.local
frontend/.env.production.local

npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Frontend env files (real ones — keep .example committed)
frontend/.env.development
frontend/.env.production

# ── Backend ───────────────────────────────────────────
backend/__pycache__/
backend/**/__pycache__/
backend/*.pyc
backend/**/*.pyc
backend/db.sqlite3
backend/.env
backend/media/
backend/staticfiles/
backend/venv/

# Editor settings. Kept out of the repo because these files routinely hold
# API keys for editor AI extensions — a Groq key reached commit history this
# way once already and had to be stripped with filter-branch.
.vscode/
.idea/
