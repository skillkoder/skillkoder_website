# ============================================================
# SkillKoder Backend — Environment Variables
# ============================================================
# Copy this file to .env and fill in your values.
# NEVER commit the real .env file to Git.
#
# Local dev:   DEBUG=True  (SQLite, no MEDIA_ROOT needed)
# EC2 prod:    DEBUG=False (PostgreSQL, set MEDIA_ROOT)
# ============================================================

# ---------------------------------------------------------------
# Core Django
# ---------------------------------------------------------------
# Generate a new one: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=your-super-secret-key-change-me-in-production

# True for local development, False on EC2
DEBUG=True

# Comma-separated list of allowed hostnames
# Local:      localhost,127.0.0.1
# EC2:        localhost,127.0.0.1,YOUR_EC2_PUBLIC_IP,api.skillkoder.com
ALLOWED_HOSTS=localhost,127.0.0.1

# ---------------------------------------------------------------
# Database (only required when DEBUG=False / production)
# ---------------------------------------------------------------
DB_NAME=skillkoder_db
DB_USER=skillkoder_user
DB_PASSWORD=your-database-password
DB_HOST=localhost
DB_PORT=5432

# ---------------------------------------------------------------
# Media & Static files (production EC2 paths)
# On EC2 these must match the Nginx alias paths in skillkoder_nginx.conf
# Leave empty for local dev — defaults to backend/media & backend/staticfiles
# ---------------------------------------------------------------
MEDIA_ROOT=/var/www/skillkoder/media
STATIC_ROOT=/var/www/skillkoder/staticfiles

# ---------------------------------------------------------------
# CORS — frontend domains allowed to call the API
# Local dev:   http://localhost:3000,http://127.0.0.1:3000
# Production:  https://skillkoder.com,https://www.skillkoder.com
# ---------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ---------------------------------------------------------------
# Virtual Try-On — self-hosted CatVTON GPU server (server-only; never expose to the frontend)
# TRYON_SERVER_URL: http://127.0.0.1:8002 when on the same PC, or your Cloudflare tunnel https URL
# TRYON_API_KEY:    the same secret the GPU server was started with
# Leave empty to show the page as "offline".
# ---------------------------------------------------------------
TRYON_SERVER_URL=
TRYON_API_KEY=
