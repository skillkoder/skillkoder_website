<?xml version="1.0" encoding="UTF-8"?>
<!--
  THIS FILE IS NO LONGER THE DEPLOYED SITEMAP.

  `npm run build` copies public/ into build/ and then runs
  scripts/prerender.mjs, which OVERWRITES build/sitemap.xml with one generated
  from the same route list that produces the static page shells. That generated
  file is what ships.

  This copy is kept only so the repository still contains a valid sitemap if
  someone serves public/ directly. It lists a subset of the live URLs and will
  drift — do not edit it expecting the change to appear on the site. To change
  what is submitted to search engines, change the routes or the PRIORITY /
  CHANGEFREQ rules in scripts/prerender.mjs.
-->
